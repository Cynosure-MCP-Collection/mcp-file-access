{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/file-access",
    "description": "MCP server for safe file access, editing, directory browsing, and image thumbnails",
    "version": "1.0.0",
    "icons": [
        {
            "src": "https://raw.githubusercontent.com/andreasjhagen/Cynosure-MCPs/main/mcp-file-access/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/file-access",
            "version": "1.0.0",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "FILE_ACCESS_ALLOWED_DIRECTORIES",
                    "description": "Path-list of directories this MCP may read and write. Uses the platform path separator (: on Linux/macOS, ; on Windows). Defaults to the current working directory.",
                    "isRequired": false,
                    "format": "string",
                    "isSecret": false
                }
            ]
        }
    ],
    "repository": {
        "url": "https://github.com/andreasjhagen/Cynosure-MCPs",
        "source": "github",
        "subfolder": "mcp-file-access"
    }
}
