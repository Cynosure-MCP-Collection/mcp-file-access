{
    "name": "@cynosure-mcp/file-access",
    "mcpName": "io.github.andreasjhagen/file-access",
    "version": "1.1.1",
    "description": "MCP server for safe file access, editing, directory browsing, ZIP archives, and image thumbnails",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "file-access": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "release:check": "node scripts/sync-version.mjs --check",
        "version": "node scripts/sync-version.mjs && git add server.json"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.27.1",
        "archiver": "^8.0.0",
        "sharp": "^0.34.5",
        "unzipper": "^0.12.5",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/archiver": "^8.0.0",
        "@types/node": "^22.0.0",
        "@types/unzipper": "^0.10.11",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    },
    "files": [
        "dist",
        "server.json",
        "icon.png"
    ],
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "filesystem",
        "files",
        "image",
        "thumbnails",
        "ai"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-file-access.git"
    },
    "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-file-access#readme",
    "bugs": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-file-access/issues"
    }
}
