{
    "name": "@cynosure-mcp/file-access",
    "mcpName": "io.github.andreasjhagen/file-access",
    "version": "1.0.0",
    "description": "MCP server for safe file access, editing, directory browsing, and image thumbnails",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "file-access": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.27.1",
        "sharp": "^0.34.5",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    },
    "files": [
        "dist",
        "server.json",
        "icon.png"
    ],
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "filesystem",
        "files",
        "image",
        "thumbnails",
        "ai"
    ]
}
